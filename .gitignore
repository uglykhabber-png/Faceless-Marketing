```gitignore
# Compiled Python files
*.pyc
__pycache__/

# Dependencies
.venv/
venv/
node_modules/

# Build/dist directories
build/
dist/
*.egg-info/

# Logs
*.log

# Editors/IDEs
.vscode/
.idea/

# Environment files
.env
.env.local
*.env.*

# Coverage reports
.coverage
coverage/
htmlcov/

# Testing
.pytest_cache/
.mypy_cache/
```